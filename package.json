{
  "name": "comfyui-desktop-2",
  "version": "1.1.7",
  "description": "Comfy Desktop",
  "author": {
    "name": "Comfy Org",
    "email": "support@comfy.org",
    "url": "https://www.comfy.org"
  },
  "repository": "github:Comfy-Org/Comfy-Desktop",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://github.com/Comfy-Org/Comfy-Desktop",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.34.6",
  "main": "./out/main/index.js",
  "scripts": {
    "init": "pnpm install && pnpm run bootstrap",
    "init:dev": "pnpm run init && pnpm run dev",
    "predev": "node -e \"const fs=require('fs'),p=process.platform==='win32'?'win-'+process.arch:process.platform==='darwin'?'mac-arm64':'linux-'+process.arch;if(!fs.existsSync('bootstrap-python/'+p))console.log('\\n\\x1b[33m⚠ Bootstrap python not found. Run \\\"pnpm run bootstrap\\\" for pre-install git support.\\x1b[0m\\n')\"",
    "dev": "electron-vite dev",
    "predev:bootstrap": "node -e \"const fs=require('fs'),p=process.platform==='win32'?'win-'+process.arch:process.platform==='darwin'?'mac-arm64':'linux-'+process.arch;if(!fs.existsSync('bootstrap-python/'+p)){console.log('Building bootstrap python...');require('child_process').execSync('node scripts/build-bootstrap-python.mjs',{stdio:'inherit'})}\"",
    "dev:bootstrap": "node -e \"process.env.COMFY_FORCE_BOOTSTRAP_GIT='1';require('child_process').execSync('electron-vite dev',{stdio:'inherit',env:process.env})\"",
    "build": "pnpm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "postinstall": "node ./scripts/postinstall.mjs",
    "todesktop:beforeInstall": "./scripts/todesktop-beforeInstall.cjs",
    "todesktop:beforeBuild": "./scripts/todesktop-beforeBuild.cjs",
    "todesktop:afterPack": "./scripts/todesktop-afterPack.cjs",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.e2e.json --composite false",
    "typecheck:integration": "tsc --noEmit -p tsconfig.vitest-integration.json --composite false",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web && pnpm run typecheck:e2e && pnpm run typecheck:integration && pnpm run typecheck:storybook",
    "build:unpack": "pnpm run build && electron-builder --dir",
    "build:win": "pnpm run build && electron-builder --win",
    "build:mac": "pnpm run build && electron-builder --mac",
    "build:linux": "pnpm run build && electron-builder --linux",
    "bootstrap": "node scripts/build-bootstrap-python.mjs",
    "bootstrap:fetch": "node scripts/fetch-bootstrap-python.mjs",
    "bridge-types:gen": "pnpm exec tsc -p tsconfig.comfy-desktop-bridge-types.json && pnpm exec prettier --write \"packages/comfyui-desktop-bridge-types/*.d.ts\"",
    "bridge-types:check": "pnpm run bridge-types:gen && git add --intent-to-add -- 'packages/comfyui-desktop-bridge-types/*.d.ts' && git diff --exit-code -- 'packages/comfyui-desktop-bridge-types/*.d.ts'",
    "font:fetch": "node scripts/fetch-font.mjs",
    "sandbox:gen": "node scripts/generate-sandbox.mjs",
    "datadog:sourcemaps:upload": "node ./scripts/upload-datadog-sourcemaps.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,vue}\" \"tests/**/*.ts\" \"*.{json,ts,yml}\" \".storybook/**/*.ts\" \"stories/**/*.{ts,vue}\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue}\" \"tests/**/*.ts\" \"*.{json,ts,yml}\" \".storybook/**/*.ts\" \"stories/**/*.{ts,vue}\"",
    "test": "vitest run -c vitest.unit.config.ts",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:macos": "playwright test --project=macos",
    "test:e2e:windows": "playwright test --project=windows",
    "test:e2e:hardware-acceleration": "playwright test --project=windows e2e/hardware-acceleration.test.ts",
    "test:e2e:linux": "playwright test --project=linux",
    "test:e2e:lifecycle": "playwright test --project=lifecycle",
    "test:e2e:lifecycle:install": "playwright test --project=lifecycle e2e/lifecycle.test.ts --grep \"@sec-setup|@sec-meta\"",
    "test:e2e:lifecycle:update": "playwright test --project=lifecycle e2e/lifecycle.test.ts --grep \"@sec-setup|@sec-meta|@sec-update\"",
    "test:e2e:lifecycle:crosschannel": "playwright test --project=lifecycle e2e/lifecycle.test.ts --grep \"@sec-setup|@sec-meta|@sec-crosschannel\"",
    "test:e2e:lifecycle:snapshot": "playwright test --project=lifecycle e2e/lifecycle.test.ts --grep \"@sec-setup|@sec-meta|@sec-snapshot\"",
    "test:e2e:lifecycle:manager": "playwright test --project=lifecycle e2e/lifecycle.test.ts --grep \"@sec-setup|@sec-meta|@sec-manager\"",
    "test:e2e:lifecycle:picker": "playwright test --project=lifecycle e2e/lifecycle.test.ts --grep \"@sec-setup|@sec-meta|@sec-picker\"",
    "test:e2e:lifecycle:bootwindow": "playwright test --project=lifecycle e2e/lifecycle.test.ts --grep \"@sec-setup|@sec-meta|@sec-bootwindow\"",
    "test:e2e:lifecycle:copy": "playwright test --project=lifecycle e2e/lifecycle.test.ts --grep \"@sec-setup|@sec-meta|@sec-copy\"",
    "test:e2e:lifecycle:remote": "playwright test --project=lifecycle e2e/lifecycle.test.ts --grep \"@sec-setup|@sec-meta|@sec-remote\"",
    "test:e2e:lifecycle:delete": "playwright test --project=lifecycle e2e/lifecycle.test.ts --grep \"@sec-setup|@sec-meta|@sec-delete\"",
    "test:watch": "vitest -c vitest.unit.config.ts",
    "prepare": "node ./scripts/prepare.mjs",
    "storybook": "storybook dev -p 6006 --host 127.0.0.1 --no-open",
    "build-storybook": "storybook build",
    "typecheck:storybook": "vue-tsc --noEmit -p tsconfig.storybook.json",
    "test:storybook": "vitest run -c vitest.storybook.config.ts"
  },
  "dependencies": {
    "7zip-bin": "^5.2.0",
    "@datadog/browser-rum": "6.28.1",
    "@todesktop/runtime": "^2.1.4",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "electron-updater": "^6.8.10",
    "node-pty": "^1.1.0",
    "posthog-node": "^5.55.2",
    "semver": "^7.8.5",
    "smol-toml": "^1.9.1",
    "systeminformation": "^5.33.15",
    "tar": "^7.5.22",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@datadog/datadog-ci": "^5.25.0",
    "@electron/rebuild": "^3.7.2",
    "@eslint/js": "^10.0.1",
    "@pinia/testing": "^1.0.3",
    "@playwright/test": "^1.64.0",
    "@storybook/addon-docs": "10.6.1",
    "@storybook/addon-vitest": "10.6.1",
    "@storybook/vue3-vite": "10.6.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/semver": "^7.8.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/browser-playwright": "^4.1.11",
    "@vue/test-utils": "^2.5.1",
    "@vueuse/core": "^13.9.0",
    "electron": "40.4.1",
    "electron-builder": "^26.17.0",
    "electron-vite": "^5.0.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-unused-imports": "^4.4.1",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "happy-dom": "^20.14.6",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lucide-vue-next": "^0.525.0",
    "pinia": "^3.0.4",
    "playwright": "^1.64.0",
    "prettier": "3.8.1",
    "storybook": "10.6.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.3.7",
    "vitest": "^4.1.11",
    "vue": "^3.5.43",
    "vue-eslint-parser": "^10.4.1",
    "vue-i18n": "^11.4.14",
    "vue-tsc": "^3.3.13"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "electron-winstaller",
      "esbuild",
      "node-pty"
    ]
  }
}
