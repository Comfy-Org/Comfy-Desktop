{
  "extends": "./tsconfig.web.json",
  "compilerOptions": {
    // Stories import files that other projects own, which a composite project must list.
    "composite": false
  },
  "include": [
    ".storybook/**/*.ts",
    "stories/**/*.ts",
    "stories/**/*.vue",
    "vitest.storybook.config.ts",
    "src/renderer/src/env.d.ts",
    "src/preload/*.d.ts"
  ],
  "exclude": []
}
