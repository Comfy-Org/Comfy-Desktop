+  font-size: 13px;
+  cursor: default;
+  list-style: none;
+}
+.mar-tpl-models > summary::-webkit-details-marker {
+  display: none;
+}
+.mar-tpl-models > summary > svg:first-child {
+  color: var(--color-muted-foreground);
+}
+.mar-tpl-models > summary:focus-visible {
+  border-radius: 6px;
+  outline: 2px solid var(--color-border-focus);
