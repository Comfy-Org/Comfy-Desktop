+  display: flex;
+  flex-wrap: wrap;
+  gap: 6px;
+}
+.mar-tpl-input-chip {
+  gap: 6px;
+  height: 28px;
+  padding: 0 10px;
+  border-radius: 8px;
+  font-size: 13px;
+}
+.mar-tpl-input-chip svg {
+  flex: none;
+  color: var(--color-muted-foreground);
+}
+.mar-tpl-optional {
+  color: var(--color-muted-foreground);
+  font-size: 12px;
+}
