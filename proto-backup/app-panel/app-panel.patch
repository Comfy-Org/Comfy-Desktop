+  flex: 1;
+}
+.mar-tpl-cloud-line {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  min-height: 40px;
+  padding: 0 12px;
+  border-radius: 10px;
+  background: var(--mad-fill);
+  font-size: 13px;
+}
+.mar-tpl-cloud-line svg {
+  color: var(--color-muted-foreground);
+}
