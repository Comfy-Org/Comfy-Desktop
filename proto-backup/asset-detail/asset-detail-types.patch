+}
+.ms-edge {
+  stroke: var(--ms-wire);
+  stroke-width: 1.6;
+  stroke-linecap: round;
+}
+.ms-edge.is-hidden {
+  stroke-dasharray: 4 5;
+  opacity: 0.45;
+}
+@media (prefers-reduced-motion: reduce) {
+  .ms {
+    transition: none;
+  }
+}
+</style>
