+            :key="`h${i}`"
+            :x1="a.x"
+            :y1="a.y"
+            :x2="b.x"
+            :y2="b.y"
+            class="ms-edge is-hidden"
+          />
+          <line
+            v-for="([a, b], i) in shownEdges"
+            :key="`s${i}`"
+            :x1="a.x"
+            :y1="a.y"
+            :x2="b.x"
+            :y2="b.y"
+            class="ms-edge"
+          />
+        </template>
+        <template v-else>
+          <polygon :points="leftFace" :fill="fills.left" />
+          <polygon :points="rightFace" :fill="fills.right" />
+        </template>
+      </g>
+    </svg>
+  </div>
+</template>
